#!/bin/sh
# Design checks before every commit. Dependency-free: needs only Node 18+.
# Enable once per clone:  git config core.hooksPath .githooks
# PROTECTED (design.md §0.5): agents must not edit this hook or bypass it with --no-verify.
set -e
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if ! command -v node >/dev/null 2>&1; then
  echo "design pre-commit: node is not installed, so the design checks cannot run. Install Node 18+." >&2
  exit 1
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# tokens.css/js are generated: refresh them when tokens.json is staged, so the commit carries matching files.
if echo "$STAGED" | grep -q '^tokens/tokens.json$'; then
  node design-build/tokens-css.mjs
  git add design-build/preview/tokens.css design-build/preview/tokens.js
fi

echo "design pre-commit: lint"
node design-build/lint.mjs --quiet || {
  echo "design pre-commit: lint failed. Fix the findings above (each one names the fix), then commit again." >&2
  exit 1
}

# Render + axe only when something visual changed, and only when its deps are installed.
if echo "$STAGED" | grep -Eq '^(tokens/|design-build/(preview|studies|render\.mjs|lib/)|design/core\.md)'; then
  if [ -d design-build/node_modules/@playwright/test ] && [ -d design-build/node_modules/@axe-core/playwright ]; then
    echo "design pre-commit: render + axe"
    node design-build/render.mjs --quiet || {
      echo "design pre-commit: render/axe failed. See design-build/render-report.json and a11y-report.json." >&2
      exit 1
    }
  else
    echo "design pre-commit: WARNING render + axe skipped (not installed). Run: npm --prefix design-build ci && npx --prefix design-build playwright install chromium" >&2
  fi
fi
