{
  "$description": "Board chrome: the neutral interface of the board and studies page (toolbar, tabs, card frames, labels). Never the brand: specimens inside the cards use tokens/tokens.json. Generated into design-build/preview/chrome.css by board.mjs; lint.mjs checks every pairing below in light and dark (rule chrome-tokens). Fonts are shipped in ./fonts (SIL OFL 1.1).",
  "$extensions": {
    "org.design-system.chrome": {
      "faces": [
        { "family": "Hanken Grotesk", "file": "hanken-grotesk-wght-normal.woff2", "weight": "100 900", "unicodeRange": "U+0020-007E, U+00A0-017E, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0374-0375, U+037E, U+0384-0385, U+0387, U+0394, U+03A9, U+03BC, U+03C0, U+2013-2015, U+2018-201A, U+201C-201E, U+2020-2023, U+2025-2026, U+2030-2031, U+2039-203A, U+2044, U+20AB-20AC, U+20B1, U+20B3-20B4, U+20B8, U+20BD, U+2116, U+2122, U+2126, U+2190, U+2192, U+2202, U+2205-2206, U+220F, U+2211-2212, U+2215, U+221A, U+221E, U+222B, U+2248, U+2260, U+2264-2265, U+25CA" },
        { "family": "Board Symbols", "file": "ibm-plex-sans-symbols-wght-normal.woff2", "weight": "100 700", "unicodeRange": "U+017F, U+02BB-02BC, U+0386, U+0388-038A, U+038C, U+038E-0393, U+0395-03A1, U+03A3-03A8, U+03AA-03BB, U+03BD-03BF, U+03C1-03CE, U+2000-200D, U+2010-2012, U+2028-2029, U+202F, U+2032-2033, U+20A1, U+20A4, U+20A6, U+20A8-20AA, U+20AD-20AE, U+20B2, U+20B5, U+20B9-20BA, U+20BF, U+2113, U+212E, U+2191, U+2193-2199, U+21A9-21AA, U+21B0-21B3, U+21B6-21B7, U+21BA-21BB, U+21C4, U+21C6, U+2219, U+2236, U+2713, U+274C, U+FEFF, U+FFFD" },
        { "family": "IBM Plex Mono", "file": "ibm-plex-mono-400-normal.woff2", "weight": "400", "unicodeRange": "U+0020-007E, U+00A0-017F, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+03C0, U+2000-200D, U+2010-2015, U+2018-201A, U+201C-201E, U+2020-2022, U+2026, U+2028-2029, U+202F-2030, U+2032-2033, U+2039-203A, U+203E, U+2044, U+205F, U+20A1, U+20A4, U+20A6, U+20A8-20AE, U+20B1-20B2, U+20B4-20B5, U+20B8-20BA, U+20BD, U+20BF, U+2113, U+2116, U+2122, U+2126, U+212E, U+2190-2199, U+21A9-21AA, U+21B0-21B3, U+21B6-21B7, U+21BA-21BB, U+21C4, U+21C6, U+2202, U+2206, U+220F, U+2211-2212, U+2215, U+2219-221A, U+221E, U+222B, U+2236, U+2248, U+2260, U+2264-2265, U+25CA, U+2713, U+274C, U+FEFF, U+FFFD" },
        { "family": "IBM Plex Mono", "file": "ibm-plex-mono-500-normal.woff2", "weight": "500", "unicodeRange": "U+0020-007E, U+00A0-017F, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+03C0, U+2000-200D, U+2010-2015, U+2018-201A, U+201C-201E, U+2020-2022, U+2026, U+2028-2029, U+202F-2030, U+2032-2033, U+2039-203A, U+203E, U+2044, U+205F, U+20A1, U+20A4, U+20A6, U+20A8-20AE, U+20B1-20B2, U+20B4-20B5, U+20B8-20BA, U+20BD, U+20BF, U+2113, U+2116, U+2122, U+2126, U+212E, U+2190-2199, U+21A9-21AA, U+21B0-21B3, U+21B6-21B7, U+21BA-21BB, U+21C4, U+21C6, U+2202, U+2206, U+220F, U+2211-2212, U+2215, U+2219-221A, U+221E, U+222B, U+2236, U+2248, U+2260, U+2264-2265, U+25CA, U+2713, U+274C, U+FEFF, U+FFFD" }
      ],
      "pairings": [
        { "fg": "chrome.color.ink.1", "bg": ["chrome.color.canvas", "chrome.color.surface", "chrome.color.raised"], "min": 4.5 },
        { "fg": "chrome.color.ink.2", "bg": ["chrome.color.canvas", "chrome.color.surface", "chrome.color.raised"], "min": 4.5 },
        { "fg": "chrome.color.ink.3", "bg": ["chrome.color.canvas", "chrome.color.surface"], "min": 4.5 },
        { "fg": "chrome.color.on-inverse", "bg": ["chrome.color.inverse"], "min": 4.5 },
        { "fg": "chrome.color.status.done", "bg": ["chrome.color.surface", "chrome.color.raised"], "min": 4.5 },
        { "fg": "chrome.color.status.warn", "bg": ["chrome.color.surface", "chrome.color.raised"], "min": 4.5 },
        { "fg": "chrome.color.status.error", "bg": ["chrome.color.surface", "chrome.color.raised"], "min": 4.5 },
        { "fg": "chrome.color.focus", "bg": ["chrome.color.canvas", "chrome.color.surface"], "min": 3 },
        { "fg": "chrome.color.line-strong", "bg": ["chrome.color.surface"], "min": 1.4 }
      ]
    }
  },
  "chrome": {
    "color": {
      "$type": "color",
      "canvas": { "$value": "#f4f4f2", "$extensions": { "mode": { "light": "#f4f4f2", "dark": "#121110" } } },
      "surface": { "$value": "#ffffff", "$extensions": { "mode": { "light": "#ffffff", "dark": "#1b1a19" } } },
      "raised": { "$value": "#ecebe8", "$extensions": { "mode": { "light": "#ecebe8", "dark": "#262523" } } },
      "ink": {
        "1": { "$value": "#1c1b19", "$extensions": { "mode": { "light": "#1c1b19", "dark": "#f2f1ee" } } },
        "2": { "$value": "#5f5b55", "$extensions": { "mode": { "light": "#5f5b55", "dark": "#bcb8b1" } } },
        "3": { "$value": "#6f6b65", "$extensions": { "mode": { "light": "#6f6b65", "dark": "#9a968f" } } }
      },
      "line": { "$value": "#1c1b191a", "$extensions": { "mode": { "light": "#1c1b191a", "dark": "#ffffff17" } } },
      "line-strong": { "$value": "#1c1b1940", "$extensions": { "mode": { "light": "#1c1b1940", "dark": "#ffffff38" } } },
      "hatch": { "$value": "#1c1b190d", "$extensions": { "mode": { "light": "#1c1b190d", "dark": "#ffffff0d" } } },
      "inverse": { "$value": "#1c1b19", "$extensions": { "mode": { "light": "#1c1b19", "dark": "#f2f1ee" } } },
      "on-inverse": { "$value": "#ffffff", "$extensions": { "mode": { "light": "#ffffff", "dark": "#121110" } } },
      "focus": { "$value": "#2f5bd3", "$extensions": { "mode": { "light": "#2f5bd3", "dark": "#8fa8ff" } } },
      "status": {
        "done": { "$value": "#1d6b45", "$extensions": { "mode": { "light": "#1d6b45", "dark": "#7fd1a4" } } },
        "warn": { "$value": "#8a5300", "$extensions": { "mode": { "light": "#8a5300", "dark": "#e8b45e" } } },
        "error": { "$value": "#b3261e", "$extensions": { "mode": { "light": "#b3261e", "dark": "#f3a29b" } } }
      }
    },
    "font": {
      "ui": { "$type": "fontFamily", "$value": ["Hanken Grotesk", "Board Symbols", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "Board Symbols", "monospace"] }
    },
    "type": {
      "$type": "typography",
      "display": { "$value": { "fontFamily": "{chrome.font.ui}", "fontSize": { "value": 28, "unit": "px" }, "fontWeight": 600, "lineHeight": 1.1428, "letterSpacing": { "value": -0.4, "unit": "px" } } },
      "heading": { "$value": { "fontFamily": "{chrome.font.ui}", "fontSize": { "value": 20, "unit": "px" }, "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": { "value": -0.2, "unit": "px" } } },
      "title": { "$value": { "fontFamily": "{chrome.font.ui}", "fontSize": { "value": 16, "unit": "px" }, "fontWeight": 600, "lineHeight": 1.5, "letterSpacing": { "value": 0, "unit": "px" } } },
      "body": { "$value": { "fontFamily": "{chrome.font.ui}", "fontSize": { "value": 14, "unit": "px" }, "fontWeight": 400, "lineHeight": 1.4286, "letterSpacing": { "value": 0, "unit": "px" } } },
      "label": { "$value": { "fontFamily": "{chrome.font.ui}", "fontSize": { "value": 12, "unit": "px" }, "fontWeight": 500, "lineHeight": 1.3333, "letterSpacing": { "value": 0.1, "unit": "px" } } },
      "code": { "$value": { "fontFamily": "{chrome.font.mono}", "fontSize": { "value": 12, "unit": "px" }, "fontWeight": 400, "lineHeight": 1.3333, "letterSpacing": { "value": 0, "unit": "px" } } }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "5": { "$value": { "value": 20, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } }
    },
    "radius": {
      "$type": "dimension",
      "control": { "$value": { "value": 8, "unit": "px" } },
      "card": { "$value": { "value": 16, "unit": "px" } },
      "badge": { "$value": { "value": 999, "unit": "px" } }
    },
    "size": {
      "$type": "dimension",
      "bar": { "$value": { "value": 56, "unit": "px" } },
      "tab": { "$value": { "value": 44, "unit": "px" } },
      "control": { "$value": { "value": 32, "unit": "px" } },
      "target": { "$value": { "value": 44, "unit": "px" } },
      "row": { "$value": { "value": 152, "unit": "px" } },
      "gap": { "$value": { "value": 16, "unit": "px" } },
      "page": { "$value": { "value": 1440, "unit": "px" } },
      "minimap": { "$value": { "value": 192, "unit": "px" } },
      "icon": { "$value": { "value": 16, "unit": "px" } },
      "hairline": { "$value": { "value": 1, "unit": "px" } },
      "ring": { "$value": { "value": 2, "unit": "px" } }
    },
    "shadow": {
      "$type": "shadow",
      "card": { "$value": { "color": "#1c1b190a", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }, "$extensions": { "mode": { "light": { "color": "#1c1b190a", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }, "dark": { "color": "#00000000", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } } } },
      "pop": { "$value": { "color": "#1c1b1926", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 8, "unit": "px" }, "blur": { "value": 24, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }, "$extensions": { "mode": { "light": { "color": "#1c1b1926", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 8, "unit": "px" }, "blur": { "value": 24, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }, "dark": { "color": "#00000099", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 8, "unit": "px" }, "blur": { "value": 24, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } } } }
    }
  }
}
